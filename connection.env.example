# REFERENCE ONLY: use clinic-control.sh export, then copy gpu-connection.env privately.
# Values in the real connection.env are literal: no shell quotes or interpolation.
SEG_DATABASE_URL=postgresql+psycopg://REPLACE:REPLACE@127.0.0.1:15432/dicom_segmentation
SEG_REDIS_URL=redis://127.0.0.1:16379/3
SEG_SERVICE_TOKEN=REPLACE_WITH_EXISTING_INTERNAL_SERVICE_TOKEN
SEG_S3_ENDPOINT=http://127.0.0.1:19000
SEG_S3_ACCESS_KEY=REPLACE
SEG_S3_SECRET_KEY=REPLACE
SEG_INPUT_BUCKET=REPLACE_WITH_EXISTING_BUCKET
SEG_OUTPUT_BUCKET=REPLACE_WITH_EXISTING_OUTPUT_BUCKET
SEG_TENANT_ID=REPLACE_WITH_EXISTING_TENANT
SEG_SOURCE_ID=REPLACE_WITH_EXISTING_SOURCE
SEG_ALLOWED_PREFIX=
SEG_CHECKPOINT_DIGEST=REPLACE_WITH_INCLUDED_MODEL_DIGEST
SEG_SCRATCH=/work
SEG_MODEL_CACHE=/models
SEG_MR_ENABLED=false
# Optional test-only Swagger prefill; keep false for normal integration.
SEG_SWAGGER_AUTO_AUTHORIZE=false
CLINIC_POSTGRES_HOST=127.0.0.1
CLINIC_POSTGRES_PORT=5432
CLINIC_REDIS_HOST=127.0.0.1
CLINIC_REDIS_PORT=6379
CLINIC_MINIO_HOST=127.0.0.1
CLINIC_MINIO_PORT=9000
